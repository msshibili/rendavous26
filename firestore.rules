rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is from authenticated user
    function isAdmin() {
      return request.auth != null;
    }

    match /posters/{posterId} {
      // Public read access for posters catalog
      allow read: if true;
      
      // Admin create, update, delete access
      allow create, delete, update: if true;
    }

    match /team_scores/{scoreId} {
      // Public read and admin update access for team scores
      allow read, write: if true;
    }

    match /system/{configDoc} {
      // System config access for initialization and seed check
      allow read, write: if true;
    }
  }
}
